# ============================================================================
# CONFIGURATION E-COMMERCE AGENT - PROJET HINT.WORK
# ============================================================================
#
# Ce fichier template vous aide à configurer votre application.
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs.
#
# IMPORTANT: Ne commitez JAMAIS ce fichier avec vos vraies clés !
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AUTH_SECRET - Secret pour NextAuth.js
# ----------------------------------------------------------------------------
# Générez automatiquement avec: npx auth secret
# Ou utilisez: openssl rand -base64 32
#
AUTH_SECRET="your-generated-secret-here"

# ----------------------------------------------------------------------------
# 2. GOOGLE OAUTH - Identifiants depuis Google Cloud Console
# ----------------------------------------------------------------------------
# Configuration pour le projet Hint.work
#
# Étapes:
# 1. Allez sur: https://console.cloud.google.com/apis/credentials
# 2. Sélectionnez le projet "Hint.work"
# 3. Créez OAuth 2.0 Client ID (Web application)
# 4. Ajoutez le redirect URI: http://localhost:3000/api/auth/callback/google
# 5. Copiez Client ID et Client Secret ici
#
AUTH_GOOGLE_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="YOUR_CLIENT_SECRET"

# APIs requises (à activer dans Google Cloud Console):
# ✅ Google Analytics Admin API
# ✅ Google Analytics Data API
# ✅ People API

# ----------------------------------------------------------------------------
# 3. BASE DE DONNÉES - PostgreSQL
# ----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Option A - Local (développement):
DATABASE_URL="postgresql://postgres:password@localhost:5432/e-commerce-agent"
#
# Option B - Neon (production recommandée):
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/database"
#
# Option C - Supabase:
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
#

# ----------------------------------------------------------------------------
# 4. ANTHROPIC API - Clé API Claude
# ----------------------------------------------------------------------------
# Obtenez votre clé sur: https://console.anthropic.com/
#
# Étapes:
# 1. Connectez-vous avec votre compte Hint.work
# 2. Allez dans "API Keys"
# 3. Créez une nouvelle clé
# 4. Copiez la clé ici
#
ANTHROPIC_API_KEY="sk-ant-api03-YOUR_KEY_HERE"

# ============================================================================
# CONFIGURATION RAPIDE
# ============================================================================
#
# Utilisez le script interactif pour configurer automatiquement:
#   npx tsx scripts/setup-env.ts
#
# Ou suivez le guide complet:
#   docs/SETUP_CREDENTIALS.md
#
# Pour vérifier votre configuration:
#   npx tsx scripts/debug-google-auth.ts
#
# ============================================================================
